@page
@model ApproveExpensesModel
@{
    ViewData["Title"] = "Approve Expenses";
}

<div class="approve-container">
    <div class="page-header">
        <h1>Approve Expenses</h1>
    </div>

    <div class="pending-section">
        <h2>Pending expenses:</h2>
        
        <div class="filter-section">
            <form method="get" class="filter-form">
                <label for="filter">Filter:</label>
                <input type="text" id="filter" name="filter" value="@Model.FilterText" placeholder="Search pending expenses..." />
                <button type="submit" class="btn btn-primary">Search</button>
                @if (!string.IsNullOrEmpty(Model.FilterText))
                {
                    <a href="/ApproveExpenses" class="btn btn-secondary">Clear</a>
                }
            </form>
        </div>

        <div class="pending-table">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in Model.PendingExpenses)
                    {
                        <tr>
                            <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                            <td>@Model.GetCategoryName(expense.CategoryId)</td>
                            <td>£@expense.Amount.ToString("F2")</td>
                            <td>
                                <form method="post" style="display: inline;">
                                    <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                    <button type="submit" asp-page-handler="Approve" class="btn btn-success btn-sm">Approve</button>
                                    <button type="submit" asp-page-handler="Reject" class="btn btn-danger btn-sm">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.PendingExpenses.Any())
                    {
                        <tr>
                            <td colspan="4" class="no-data">No pending expenses to approve.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="action-section">
        <a href="/Index" class="btn btn-secondary">Back to Expenses</a>
    </div>
</div>
