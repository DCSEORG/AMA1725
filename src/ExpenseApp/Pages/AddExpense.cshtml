@page
@model AddExpenseModel
@{
    ViewData["Title"] = "Add Expense";
}

<div class="expense-form-container">
    <div class="page-header">
        <h1>Expense Management System</h1>
    </div>

    <div class="form-section">
        <h2>Add Expense</h2>
        
        <form method="post">
            <div class="form-group">
                <label for="Amount">Amount:</label>
                <input type="number" step="0.01" id="Amount" name="Amount" asp-for="Amount" required class="form-control" />
            </div>

            <div class="form-group">
                <label for="ExpenseDate">Date:</label>
                <input type="date" id="ExpenseDate" name="ExpenseDate" asp-for="ExpenseDate" required class="form-control" />
            </div>

            <div class="form-group">
                <label for="CategoryId">Category:</label>
                <select id="CategoryId" name="CategoryId" asp-for="CategoryId" class="form-control">
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.CategoryId">@category.CategoryName</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="Description">Description:</label>
                <textarea id="Description" name="Description" asp-for="Description" rows="4" class="form-control"></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Submit</button>
                <a href="/Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
